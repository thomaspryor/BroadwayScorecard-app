{
  "name": "broadwayscorecard",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "bash scripts/setup-git-hooks.sh 2>/dev/null || true",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:design": "node scripts/check-font-floor.js",
    "build:dev": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "build:prod": "eas build --profile production --platform ios",
    "submit": "eas submit --platform ios",
    "update": "eas update --branch production",
    "test:e2e": "for f in .maestro/**/*.yaml; do echo \"Running $f\" && maestro test \"$f\" || exit 1; done",
    "test:e2e:rating": "for f in .maestro/show-rating/*.yaml; do echo \"Running $f\" && maestro test \"$f\" || exit 1; done",
    "test:e2e:myshows": "for f in .maestro/my-shows/*.yaml; do echo \"Running $f\" && maestro test \"$f\" || exit 1; done",
    "test:e2e:tabs": "for f in .maestro/tabs/*.yaml; do echo \"Running $f\" && maestro test \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.98.0",
    "expo": "^57",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.8",
    "expo-web-browser": "~57.0.1",
    "fuse.js": "^7.1.0",
    "posthog-react-native": "^4.37.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.5",
    "@types/react": "~19.2.4",
    "eas-cli": "^18.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "expo-dev-client": "~57.0.7",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
